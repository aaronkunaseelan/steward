[Unit]
Description=Steward wake
ConditionPathExists=%h/.local/state/steward/state.sqlite

[Service]
Type=oneshot
ExecStart=/usr/bin/python3.12 -m steward.service wake --state %h/.local/state/steward
Environment=PYTHONPATH=%h/.local/lib/steward/current/src
Environment=PATH=%h/.local/bin:/home/ubuntu/workbench/scripts/run-tools:/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=40min
KillMode=control-group

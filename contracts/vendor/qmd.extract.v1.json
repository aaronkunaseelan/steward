{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qmd.extract.v1",
  "title": "qmd extract --json",
  "description": "Pure bytes-to-text extraction: no archive, queue, state or index. Unknown fields are null.",
  "x-owner": "qmd",
  "x-consumers": [
    "steward"
  ],
  "type": "object",
  "required": [
    "schema",
    "kind",
    "text",
    "model",
    "pages",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "qmd.extract.v1"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ],
      "description": "Extracted document kind (text, ocr or transcript); null when unknown."
    },
    "text": {
      "type": [
        "string",
        "null"
      ],
      "description": "Complete extracted text, without rendered headers or model metadata."
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "pages": {
      "type": [
        "object",
        "null"
      ],
      "description": "Page coverage from the shared extractor, or null for non-paged input.",
      "required": [
        "covered",
        "total",
        "requested"
      ],
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requested": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Short pipeline error code; null on success. Exit 0 on success, 4 on failure."
    }
  }
}

#!/usr/bin/env python3
"""Deploy only the archived edge tree of an exact commit; secrets travel via stdin."""
from pathlib import Path
import os
import json
import subprocess
import sys
import tempfile

repo = Path(__file__).resolve().parents[1]


def git(*args):
    return subprocess.check_output(['git', '-C', str(repo), *args], text=True).strip()


def page_secrets():
    # People sign in through Cloudflare Access now (cloudflare D1/P3); the only Worker secret is the API bearer.
    path = Path.home() / '.config/steward/pages.env'
    values = {}
    for line in path.read_text().splitlines():
        key, sep, value = line.partition('=')
        if sep:
            values[key.strip()] = value.strip().strip('"\'')
    if not values.get('STEWARD_PAGES_TOKEN'):
        raise SystemExit('Pages token unavailable')
    return {'STEWARD_PAGES_TOKEN': values['STEWARD_PAGES_TOKEN']}


def main():
    if len(sys.argv) != 2:
        raise SystemExit('Usage: bin/deploy-edge <sha>')
    if git('status', '--porcelain'):
        raise SystemExit('Refusing dirty working tree')
    sha = git('rev-parse', '--verify', '--end-of-options', sys.argv[1] + '^{commit}')
    code = subprocess.run(['release-guard', 'steward', sha]).returncode
    if code:
        raise SystemExit(code)
    credentials = page_secrets()
    with tempfile.TemporaryDirectory(prefix='steward-edge-') as build:
        archive = subprocess.check_output(['git', '-C', str(repo), 'archive', sha, 'edge'])
        subprocess.run(['tar', '-x', '-C', build], input=archive, check=True)
        project = Path(build) / 'edge'
        # Locked dependency install, without lifecycle scripts or credentials.
        clean = {k: v for k, v in os.environ.items() if k in ('PATH', 'HOME', 'LANG')}
        subprocess.run(['npm', 'ci', '--ignore-scripts', '--no-audit', '--no-fund'], cwd=project, env=clean, check=True)
        subprocess.run(['npm', 'test'], cwd=project, env=clean, check=True)
        cli = ['node', str(project / 'node_modules/wrangler/bin/wrangler.js')]
        env = dict(os.environ, WRANGLER_SEND_METRICS='false')
        # Secrets go up with the code: no version is ever live with the old ones (cloudflare D1/P1).
        # The file lives in the build directory (0600) and is removed with it; omitted secrets are kept.
        secrets_file = Path(build) / 'secrets.json'
        os.close(os.open(secrets_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
        secrets_file.write_text(json.dumps(credentials))
        subprocess.run([*cli, 'deploy', '--secrets-file', str(secrets_file)], cwd=project, env=env, check=True)
    print(sha + ': steward edge deployed')


if __name__ == '__main__':
    main()

#!/usr/bin/env python3
"""One-off S14 promotion migration; run with the wake service idle.

Usage: python3 bin/migrate-briefings --state STATE_ROOT --data DATA_ROOT
Existing destinations abort rather than overwrite archived evidence. Safe to resume.
"""
import argparse
from pathlib import Path
import shutil


def migrate(state, data):
    moved = 0
    for source in sorted((state / 'wakes').glob('*/briefing.md')):
        target = data / 'wakes' / source.parent.name / source.name
        target.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
        if target.exists():
            raise FileExistsError(target)
        shutil.move(str(source), target)
        if not any(source.parent.iterdir()):
            source.parent.rmdir()
        moved += 1
    old = state / 'wakes'
    if old.exists() and not any(old.iterdir()):
        old.rmdir()
    return moved


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state', type=Path, required=True)
    parser.add_argument('--data', type=Path, required=True)
    args = parser.parse_args()
    print(f'moved {migrate(args.state, args.data)} briefings')

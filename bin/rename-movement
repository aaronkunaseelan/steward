#!/usr/bin/env python3
"""S16 migration, supervisor only. Back up, stop steward.timer, wait for idle.

Calendar patches FIRST; capture their updated timestamps, then ONE store
transaction renames all versions and retires pins/deletion barriers. Historical
sense observations stay untouched: runtime projects only newly collected calendars.
On failure compensate calendar patches and leave the store untouched. Keep the
timer stopped after ANY failure (compensation also bumps Google timestamps),
resolve the failure and rerun before restarting. Dry-run uses a read-only store
and readonly Google listing, prints the entire plan, and makes no effects.
"""
import argparse
from contextlib import nullcontext
import fcntl
import hashlib
import json
from pathlib import Path
import re
import sqlite3
import subprocess

PATTERN = re.compile(r'(?<!strength_)training(?!_readiness)', re.IGNORECASE)
COLUMNS = dict(demands=('name', 'spec_json'), blocks=('event_key', 'demand', 'payload'),
               memories=('content',), interests=('name', 'spec_json'), changes=('summary',))


def rename(text):
    def replace(match):
        word = match.group()
        return 'MOVEMENT' if word.isupper() else 'Movement' if word[0].isupper() else 'movement'
    return PATTERN.sub(replace, text) if isinstance(text, str) else text


def fingerprint(value):
    return hashlib.sha256(value.encode()).hexdigest()[:12]


def run(argv):
    result = subprocess.run(argv, capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise RuntimeError('external command failed (output withheld); keep Steward stopped')
    return result.stdout


def check_idle():
    for unit in ('steward.timer', 'steward-tick.service', 'steward-wake.service'):
        state = run(['systemctl', '--user', 'show', unit, '--property=ActiveState', '--value']).strip()
        if state not in ('inactive', 'failed'):
            raise RuntimeError(unit + ' is ' + state + '; stop timer and wait for tick/wake idle')


def patch_command(calendar, event, key, summary):
    argv = ['gog', '--enable-commands-exact=calendar.update', '--no-input', '-j',
            'cal', 'update', calendar, event['id'], '--summary', summary, '--send-updates=none']
    for name, value in dict(event['extendedProperties']['private'], event_key=key).items():
        argv.extend(['--private-prop', name + '=' + value])
    return argv


def migrate(path, calendar, dry_run=False, runner=run, check_idle=check_idle):
    if dry_run:
        print('Precondition for real run: supervisor stops steward.timer; script refuses active tick/wake/timer')
    else:
        check_idle()
    path = Path(path).resolve()
    lock = nullcontext() if dry_run else (path.parent / 'writer.lock').open('a+b')
    result = dict(rows={}, events=0, history={}, unpinned=0, unblocked=0, calendar_senses=0)
    done = []
    with lock as stream:
        if not dry_run:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        db = sqlite3.connect(path.as_uri() + ('?mode=ro' if dry_run else '?mode=rw'), uri=True)
        db.row_factory = sqlite3.Row
        try:
            db.execute('BEGIN' if dry_run else 'BEGIN IMMEDIATE')
            raw = json.loads(runner(['gog', '--readonly', '--enable-commands-exact=calendar.events',
                '--no-input', '-j', 'cal', 'events', calendar, '--from', '1970-01-01T00:00:00Z',
                '--to', '2100-01-01T00:00:00Z', '--all-pages', '--max', '250']))
            events = raw if isinstance(raw, list) else raw['events']
            patches = [e for e in events if e.get('status') != 'cancelled' and
                       e.get('extendedProperties', {}).get('private', {}).get('event_key', '').startswith('training:')]
            baselines = {}
            result['events'] = len(patches)
            for event in patches:
                old = event['extendedProperties']['private']['event_key']
                new = 'movement:' + old[len('training:'):]
                summary = rename(event.get('summary', ''))
                print(f'calendar event={event["id"]} event_key={old} -> {new}; summary={summary!r}; capture response.updated', flush=True)
                if not dry_run:
                    # Record before calling: a timed-out write may have succeeded.
                    done.append(event)
                    raw = json.loads(runner(patch_command(calendar, event, new, summary)))
                    actual = raw.get('event', raw)
                    if actual.get('id') != event['id'] or not actual.get('updated'):
                        raise RuntimeError('calendar patch response missing id/updated; keep Steward stopped')
                    baselines[new] = actual['updated']
            print('ONE store transaction: rename versions, set patched updated baselines, pinned -> applied, tombstone -> removed; senses untouched')
            for table, columns in COLUMNS.items():
                count = 0
                extra = ', state' if table == 'blocks' else ''
                for row in db.execute(f'SELECT rowid AS migration_rowid, {", ".join(columns)}{extra} FROM {table}').fetchall():
                    edits = {column: rename(row[column]) for column in columns if rename(row[column]) != row[column]}
                    if table == 'blocks':
                        key = rename(row['event_key'])
                        if key in baselines:
                            payload = json.loads(edits.get('payload', row['payload']))
                            payload['updated'] = baselines[key]
                            edits['payload'] = json.dumps(payload)
                        elif dry_run and any(e['extendedProperties']['private']['event_key'] == row['event_key'] for e in patches):
                            print(f'blocks rowid={row["migration_rowid"]} payload.updated <- patched response.updated')
                        if row['state'] == 'pinned':
                            edits['state'] = 'applied'
                            result['unpinned'] += 1
                        elif row['state'] == 'tombstone':
                            edits['state'] = 'removed'
                            result['unblocked'] += 1
                    if not edits:
                        continue
                    count += 1
                    for column, value in edits.items():
                        before = row[column]
                        print(f'{table} rowid={row["migration_rowid"]} {column}: sha256={fingerprint(before)} -> {fingerprint(value)}')
                    if not dry_run:
                        assignments = ', '.join(column + '=?' for column in edits)
                        db.execute(f'UPDATE {table} SET {assignments} WHERE rowid=?', [*edits.values(), row['migration_rowid']])
                result['rows'][table] = count
            print('senses: all historical observations preserved; no invalidation or appended row')
            for table in ('outbox', 'told'):
                rows = db.execute(f'SELECT * FROM {table}').fetchall()
                matching = sum(any(isinstance(value, str) and PATTERN.search(value) for value in row) for row in rows)
                result['history'][table] = dict(total=len(rows), matching=matching)
                print(f'{table}: preserved {len(rows)} rows ({matching} containing legacy vocabulary)')
            if dry_run:
                db.rollback()
                print('DRY RUN: store untouched; no calendar writes. Failure plan: restore original event keys/summaries; keep timer stopped.')
            else:
                db.commit()
                print('Store committed. Supervisor may swap release/install mind, then restart steward.timer.')
            print(json.dumps(result, sort_keys=True))
            return result
        except Exception:
            db.rollback()
            # Try every compensation even if one fails; expose IDs, never provider output.
            failed = []
            for event in reversed(done):
                try:
                    runner(patch_command(calendar, event, event['extendedProperties']['private']['event_key'], event.get('summary', '')))
                    print(f'calendar event={event["id"]}: restored key/summary; keep timer stopped', flush=True)
                except Exception:
                    failed.append(event['id'])
            if failed:
                raise RuntimeError('Calendar compensation failed for ' + ', '.join(failed) + '; store untouched; keep timer stopped') from None
            raise
        finally:
            db.close()


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--store', type=Path, required=True)
    parser.add_argument('--calendar', required=True, help='Schedule calendar ID, never a main calendar')
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()
    migrate(args.store, args.calendar, args.dry_run)
